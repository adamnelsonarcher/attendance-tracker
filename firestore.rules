rules_version = '2';

/**
 * Shared tables are unauthenticated: knowing the six-character code is the only
 * credential. These rules cannot change that, but they do close the ways a code
 * could be found, and they stop the database being used as something other than
 * an attendance tracker.
 *
 * Deploy with:  npm run deploy:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isTableCode(code) {
      return code.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$');
    }

    function tableExists(database, code) {
      return exists(/databases/$(database)/documents/tables/$(code));
    }

    /**
     * Each slice has a known shape. Settings is left open beyond its one list
     * field on purpose: it is the part that grows, and a rule enumerating its
     * keys would reject every new setting until these rules were redeployed.
     */
    function isValidSlice(slice, data) {
      return (slice == 'roster'
                && data.keys().hasOnly(['people', 'groups'])
                && data.people is list && data.groups is list)
          || (slice == 'schedule'
                && data.keys().hasOnly(['folders', 'events'])
                && data.folders is list && data.events is list)
          || (slice == 'settings'
                && (!data.keys().hasAny(['statuses']) || data.statuses is list))
          || slice == 'attendance';
    }

    match /tables/{code} {
      // `get` but never `list`. Without `list` the collection cannot be walked,
      // so a code has to be guessed against 32^6 ~= 10^9 possibilities one
      // request at a time.
      allow get: if isTableCode(code);
      allow list: if false;

      allow create: if isTableCode(code)
                    && request.resource.data.keys().hasOnly(
                         ['version', 'name', 'createdAt', 'lastUpdated']);

      // Checks which keys the write actually CHANGES, not what the finished
      // document contains. `setDoc(..., { merge: true })` sends the merged
      // result, so a `keys().hasOnly(...)` test here would reject a metadata
      // touch on a table created by an older version of the app — one that
      // still carries people/events/attendance in this same document.
      allow update: if isTableCode(code)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ['version', 'name', 'lastUpdated']);

      allow delete: if false;

      match /slices/{slice} {
        allow get: if isTableCode(code);
        allow list: if false;

        // Requiring the parent to exist stops slice documents being created
        // under codes that were never handed out — otherwise the collection is
        // writable storage for anyone with the public web config.
        allow create, update: if isTableCode(code)
                              && tableExists(database, code)
                              && slice in ['roster', 'schedule', 'settings', 'attendance']
                              // Firestore caps a document at 1 MiB and 40,000
                              // index entries; this keeps a slice recognisable
                              // as a slice. For attendance it is people x events.
                              && request.resource.data.size() <= 20000
                              && isValidSlice(slice, request.resource.data);

        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
