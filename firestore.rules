rules_version = '2';

/**
 * Shared tables are unauthenticated: knowing the six-character code is the only
 * credential. These rules cannot change that, but they do close the ways a code
 * could be found, and they stop the database being used as something other than
 * an attendance tracker.
 *
 * Deploy with:  npm run deploy:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isTableCode(code) {
      return code.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$');
    }

    match /tables/{code} {
      // `get` but never `list`. Without `list` the collection cannot be walked,
      // so a code has to be guessed against 32^6 ~= 10^9 possibilities one
      // request at a time.
      allow get: if isTableCode(code);
      allow list: if false;

      allow create: if isTableCode(code)
                    && request.resource.data.keys().hasOnly(
                         ['version', 'name', 'createdAt', 'lastUpdated']);

      // Checks which keys the write actually CHANGES, not what the finished
      // document contains. `setDoc(..., { merge: true })` sends the merged
      // result, so a `keys().hasOnly(...)` test here would reject a metadata
      // touch on a table created by an older version of the app — one that
      // still carries people/events/attendance in this same document.
      allow update: if isTableCode(code)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ['version', 'name', 'lastUpdated']);

      allow delete: if false;

      match /slices/{slice} {
        allow get: if isTableCode(code);
        allow list: if false;

        // Only the four slices the app knows about. Firestore caps documents at
        // 1 MiB and 40,000 index entries on its own; the field count here is
        // about keeping a slice recognisable as a slice, not about bytes.
        allow write: if isTableCode(code)
                     && slice in ['roster', 'schedule', 'settings', 'attendance']
                     && request.resource.data.size() <= 20000;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
