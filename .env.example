# Firebase project used for shared tables. Leave these blank to run the app
# local-only: everything works except sharing.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional. A reCAPTCHA v3 site key registered under Firebase App Check, which
# makes Firestore requests prove they came from this app. Leave blank to skip.
REACT_APP_APPCHECK_SITE_KEY=
